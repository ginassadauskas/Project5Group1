   "source": [
    "import pandas as pd\n",
    "\n",
    "df = pd.read_excel(\"Cleaned Bus Planning.xlsx\")\n",
    "x = \"line\"\n",
    "line = None\n",
    "for i in range(len(df) -1, -1, -1):\n",
    "    if pd.notna(df.loc[i, x]):\n",
    "        line = df.loc[i, x]\n",
    "    else:\n",
    "        df.loc[i, x] = line\n",
    "df.to_excel(\"Lines fixed.xlsx\")"
   ]
